diff --git a/compat/linux/fs.h b/compat/linux/fs.h
new file mode 100644
index 0000000..b00e89f
--- /dev/null
+++ b/compat/linux/fs.h
@@ -0,0 +1,14 @@
+/* macOS compat shim: linux/fs.h is only needed for BLKGETSIZE64, which is
+ * never reached for regular image files (fstat path handles it). Fork-local. */
+#ifndef _COMPAT_LINUX_FS_H
+#define _COMPAT_LINUX_FS_H
+
+#include <sys/ioctl.h>
+
+/* Never reached for regular image files (fstat path handles them), but the
+ * symbol must exist to compile. */
+#ifndef BLKGETSIZE64
+#define BLKGETSIZE64 _IOR(0x12, 114, size_t)
+#endif
+
+#endif /* _COMPAT_LINUX_FS_H */
