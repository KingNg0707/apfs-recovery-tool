diff --git a/compat/mmap_shim.h b/compat/mmap_shim.h
new file mode 100644
index 0000000..c8e72bd
--- /dev/null
+++ b/compat/mmap_shim.h
@@ -0,0 +1,52 @@
+/* Fork-local macOS compat (data recovery): macOS APFS returns EINVAL from
+ * mmap() for pages inside sparse-file holes, while pread() reads them fine as
+ * zeros. Replace all file-backed mmap in apfsck TUs with calloc+pread.
+ * Included via -include before every TU's own headers; pulls sys/mman.h in
+ * first so the real prototypes are declared before the macros redefine them.
+ * NOTE: read-only use only — writes to "mapped" buffers become local copies. */
+#ifndef _COMPAT_MMAP_SHIM_H
+#define _COMPAT_MMAP_SHIM_H
+#ifdef __APPLE__
+
+#include <sys/mman.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+
+static inline void *apfs_mmap_shim(void *addr, size_t len, int prot, int flags, int fd, off_t off)
+{
+	void *buf;
+	ssize_t got;
+
+	(void)addr; (void)prot;
+	if (len == 0) { errno = EINVAL; return MAP_FAILED; }
+
+	if ((flags & MAP_ANON) != 0 || fd < 0) { /* anonymous scratch */
+		buf = calloc(1, len);
+		return buf ? buf : MAP_FAILED;
+	}
+
+	buf = calloc(1, len);
+	if (!buf) { errno = ENOMEM; return MAP_FAILED; }
+	got = pread(fd, buf, len, off);
+	if (got < 0) {
+		free(buf);
+		return MAP_FAILED;
+	}
+	/* Short read past EOF: rest stays zero. */
+	return buf;
+}
+
+static inline int apfs_munmap_shim(void *p, size_t len)
+{
+	(void)len;
+	free(p);
+	return 0;
+}
+
+#define mmap(a, l, p, f, fd, o) apfs_mmap_shim((a), (l), (p), (f), (fd), (o))
+#define munmap(p, l)             apfs_munmap_shim((p), (l))
+
+#endif /* __APPLE__ */
+#endif /* _COMPAT_MMAP_SHIM_H */
