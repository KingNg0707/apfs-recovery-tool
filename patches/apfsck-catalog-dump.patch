diff --git a/apfsck/btree.c b/apfsck/btree.c
index da06f9a..f328628 100644
--- a/apfsck/btree.c
+++ b/apfsck/btree.c
@@ -949,6 +949,13 @@ static void parse_subtree(struct node *root,
 		btree->key_count += root->records;
 	}
 	++btree->node_count;
+	if (btree->node_count % 100000 == 0) {
+		static const char *tn[] = {"?", "omap", "cat", "extref",
+			"snapmeta", "freeq", "snaps", "fext", "fusion"};
+		fprintf(stderr, "[progress] tree=%s nodes=%llu\n",
+			btree->type < 9 ? tn[btree->type] : "?",
+			(unsigned long long)btree->node_count);
+	}
 
 	if (btree_is_omap(btree) && !node_has_fixed_kv_size(root))
 		report("Object map", "key size should be fixed.");
@@ -2091,3 +2098,151 @@ next_node:
 	}
 	goto next_node;
 }
+
+/* ------------------------------------------------------------------
+ * Data-recovery extension: stream catalog records to a FILE.
+ * Read-only DFS over the catalog B-tree; emits TSV lines consumed by build_index.py:
+ *   I<TAB>cnid<TAB>mode<TAB>size<TAB>btime<TAB>mtime
+ *   D<TAB>parent_cnid<TAB>child_cnid<TAB>drec_flags<TAB>name(escaped)
+ * ------------------------------------------------------------------ */
+
+static void cat_dump_escape(FILE *out, const char *s, int len)
+{
+	int i;
+
+	for (i = 0; i < len; ++i) {
+		unsigned char c = (unsigned char)s[i];
+		switch (c) {
+		case '\t': fputs("\\t", out); break;
+		case '\n': fputs("\\n", out); break;
+		case '\r': fputs("\\r", out); break;
+		case '\\': fputs("\\\\", out); break;
+		default:
+			if (c < 0x20)
+				fprintf(out, "\\u%04x", c);
+			else
+				fputc(c, out);
+		}
+	}
+}
+
+static void cat_dump_node(struct node *node, FILE *out)
+{
+	struct btree *btree = node->btree;
+	static unsigned long long dump_nodes = 0;
+	int i;
+
+	if (++dump_nodes % 50000 == 0) {
+		fprintf(stderr, "[dump-progress] nodes=%llu\n", dump_nodes);
+		fflush(stderr);
+	}
+	for (i = 0; i < node->records; ++i) {
+		void *raw_key, *raw_val;
+		int off, len;
+
+		len = node_locate_key(node, i, &off);
+		raw_key = (char *)node->raw + off;
+		len = node_locate_data(node, i, &off);
+		raw_val = (char *)node->raw + off;
+
+		if (!node_is_leaf(node)) {
+			u64 child_id = le64_to_cpu(*(__le64 *)(raw_val));
+			struct node *child = read_node(child_id, btree, NULL);
+
+			cat_dump_node(child, out);
+			continue;
+		}
+
+		if (len < sizeof(struct apfs_key_header))
+			continue;
+		{
+			struct key curr_key;
+			read_cat_key(raw_key, len, &curr_key);
+
+			switch (curr_key.type) {
+			case APFS_TYPE_INODE: {
+				struct apfs_inode_val *val = raw_val;
+
+				if (len < 60)
+					break;
+				fprintf(out, "I\t%llu\t%u\t%llu\t%llu\t%llu\n",
+					(unsigned long long)curr_key.id,
+					(unsigned)le16_to_cpu(val->mode),
+					(unsigned long long)le64_to_cpu(val->uncompressed_size),
+					(unsigned long long)le64_to_cpu(val->create_time),
+					(unsigned long long)le64_to_cpu(val->mod_time));
+				break;
+			}
+			case APFS_TYPE_DIR_REC: {
+				struct apfs_drec_val *val = raw_val;
+				const char *name;
+				int namelen;
+
+				if (len < sizeof(*val))
+					break;
+				if (apfs_is_normalization_insensitive()) {
+					struct apfs_drec_hashed_key *hkey = raw_key;
+					name = (const char *)hkey->name;
+					namelen = le32_to_cpu(hkey->name_len_and_hash) & 0x3FFU;
+				} else {
+					struct apfs_drec_key *ukey = raw_key;
+					name = (const char *)ukey->name;
+					namelen = le16_to_cpu(ukey->name_len);
+				}
+				if (namelen < 0 || namelen > 1024)
+					namelen = 0;
+				fprintf(out, "D\t%llu\t%llu\t%u\t",
+					(unsigned long long)curr_key.id,
+					(unsigned long long)le64_to_cpu(val->file_id),
+					(unsigned)le16_to_cpu(val->flags));
+				cat_dump_escape(out, name, namelen);
+				fputc('\n', out);
+				break;
+			}
+			case APFS_TYPE_FILE_EXTENT: {
+				struct apfs_file_extent_key *ekey = raw_key;
+				struct apfs_file_extent_val *eval = raw_val;
+
+				if (len < sizeof(*eval))
+					break;
+				fprintf(out, "E\t%llu\t%llu\t%llu\t%u\t%llu\n",
+					(unsigned long long)curr_key.id,
+					(unsigned long long)le64_to_cpu(ekey->logical_addr),
+					(unsigned long long)(le64_to_cpu(eval->len_and_flags) & APFS_FILE_EXTENT_LEN_MASK),
+					(unsigned)((le64_to_cpu(eval->len_and_flags) & APFS_FILE_EXTENT_FLAG_MASK) >> APFS_FILE_EXTENT_FLAG_SHIFT),
+					(unsigned long long)le64_to_cpu(eval->phys_block_num));
+				break;
+			}
+			default:
+				break;
+			}
+		}
+	}
+}
+
+void apfs_dump_catalog(FILE *out)
+{
+	if (!vsb || !vsb->v_cat || !vsb->v_cat->root) {
+		fprintf(stderr, "[dump] no catalog tree parsed\n");
+		return;
+	}
+	cat_dump_node(vsb->v_cat->root, out);
+	fflush(out);
+}
+
+void apfs_dump_catalog_raw(u64 root_oid)
+{
+	struct btree fake;
+	FILE *out;
+	struct node *root;
+
+	out = fopen(getenv("APFS_DUMP"), "w");
+	if (!out)
+		system_error();
+	memset(&fake, 0, sizeof(fake));
+	fake.type = BTREE_TYPE_CATALOG;
+	fake.omap_table = vsb->v_omap_table;
+	root = read_node(root_oid, &fake, NULL);
+	cat_dump_node(root, out);
+	fclose(out);
+}
