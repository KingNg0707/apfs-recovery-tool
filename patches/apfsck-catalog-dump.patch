diff --git a/apfsck/super.c b/apfsck/super.c
index 317da81..9d419cd 100644
--- a/apfsck/super.c
+++ b/apfsck/super.c
@@ -64,10 +64,28 @@ static inline unsigned int blksize_bits(unsigned int size)
  *
  * Sets sb->s_blocksize and returns a pointer to the raw superblock in memory.
  */
+/*
+ * Data-recovery extension: override the container superblock location.
+ *
+ * In some damaged images the standard NXSB copy at APFS_NX_BLOCK_NUM has been
+ * overwritten (e.g. by another filesystem's quick format) while valid copies
+ * of a newer NXSB survive elsewhere in the image.  Set APFS_SB_BLOCK to the
+ * block number of such a copy (decimal or 0x-prefixed hex) to read it instead.
+ */
+static u64 sb_block_override(void)
+{
+	const char *env = getenv("APFS_SB_BLOCK");
+
+	if (!env || !*env)
+		return APFS_NX_BLOCK_NUM;
+	return strtoull(env, NULL, 0);
+}
+
 static struct apfs_nx_superblock *read_super_copy(void)
 {
 	struct apfs_nx_superblock *msb_raw;
 	int bsize_tmp;
+	u64 sb_bno = sb_block_override();
 
 	/*
 	 * For now assume a small blocksize, we only need it so that we can
@@ -76,7 +94,7 @@ static struct apfs_nx_superblock *read_super_copy(void)
 	bsize_tmp = APFS_NX_DEFAULT_BLOCK_SIZE;
 
 	msb_raw = mmap(NULL, bsize_tmp, PROT_READ, MAP_PRIVATE,
-		       fd_main, APFS_NX_BLOCK_NUM * bsize_tmp);
+		       fd_main, sb_bno * bsize_tmp);
 	if (msb_raw == MAP_FAILED)
 		system_error();
 
@@ -90,7 +108,7 @@ static struct apfs_nx_superblock *read_super_copy(void)
 		munmap(msb_raw, bsize_tmp);
 
 		msb_raw = mmap(NULL, sb->s_blocksize, PROT_READ, MAP_PRIVATE,
-			       fd_main, APFS_NX_BLOCK_NUM * sb->s_blocksize);
+			       fd_main, sb_bno * sb->s_blocksize);
 		if (msb_raw == MAP_FAILED)
 			system_error();
 	}
@@ -1087,6 +1105,20 @@ void check_volume_super(void)
 	if (!vsb->v_in_snapshot) {
 		vsb->v_omap = parse_omap_btree(vsb->v_omap_oid);
 		vsb->v_snap_meta = parse_snap_meta_btree(vsb->v_snap_meta_oid);
+
+		/* Data-recovery extension: stream the catalog tree to $APFS_DUMP
+		 * and exit, skipping the remaining fsck checks. */
+		{
+			const char *df = getenv("APFS_DUMP");
+			const char *dx = getenv("APFS_DUMP_XID");
+			if (df && *df && (!dx || sb->s_xid == strtoull(dx, NULL, 0))) {
+				fprintf(stderr, "[dump] xid=%llu vol=%.64s -> %s\n",
+					(unsigned long long)sb->s_xid,
+					vsb_raw->apfs_volname, df);
+				apfs_dump_catalog_raw(le64_to_cpu(vsb_raw->apfs_root_tree_oid));
+				exit(0);
+			}
+		}
 	}
 
 	/* A virtual object, so it must be parsed after the omap */
@@ -1263,8 +1295,15 @@ static void parse_main_super(struct super_block *sb)
 		report("Container superblock", "reports no block count.");
 	sb->s_max_main_blkcnt = get_main_device_size(sb->s_blocksize);
